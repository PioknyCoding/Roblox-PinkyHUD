--======================== FLOW: splash → key → GUI ========================--
local guiDestroyed = false
local readyEvent = Instance.new("BindableEvent")

showSplash()

task.delay(2.6, function()
    if guiDestroyed then return end
    local AUTH_KEY = getAuthKey()
    if not AUTH_KEY then
        showKeyCard(function()
            -- If the fetch failed but the user somehow continues, just retry the fetch.
            local retryKey = getAuthKey()
            if not retryKey then return end
            saveKey(retryKey)
            initMainGUI()
            readyEvent:Fire()
        end, function()
            guiDestroyed = true
            ScreenGui:Destroy()
            readyEvent:Fire()
        end)
        return
    end
    local savedKey = loadSavedKey()
    if savedKey == AUTH_KEY then
        initMainGUI()
        readyEvent:Fire()
    else
        showKeyCard(function()
            saveKey(AUTH_KEY)
            initMainGUI()
            readyEvent:Fire()
        end, function()
            guiDestroyed = true
            ScreenGui:Destroy()
            readyEvent:Fire()
        end)
    end
end)

readyEvent.Event:Wait()

if guiDestroyed then
    return {}
end

return Hub
