    local accentBar = make("Frame", {
        BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = toast,
    })
    corner(accentBar, 2)

    local textHolder = make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 8, 0, 0),
        Parent = toast,
    })
