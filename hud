-- ============================================================
-- Boot sequence
-- ============================================================

local guiDestroyed = false
local readyEvent = Instance.new("BindableEvent")

showSplash()

task.delay(2.6, function()
    if guiDestroyed then return end

    local currentAuthKey = getAuthKey()

    if not currentAuthKey then
        showKeyCard(function()
            local retryKey = getAuthKey()
            if not retryKey then return end
            saveKey(retryKey)
            initMainGUI()
            readyEvent:Fire()
        end, function()
            guiDestroyed = true
            ScreenGui:Destroy()
            readyEvent:Fire()
        end)
        return
    end

    local savedKey = loadSavedKey()

    if savedKey == currentAuthKey then
        initMainGUI()
        readyEvent:Fire()
    else
        showKeyCard(function()
            saveKey(currentAuthKey)
            initMainGUI()
            readyEvent:Fire()
        end, function()
            guiDestroyed = true
            ScreenGui:Destroy()
            readyEvent:Fire()
        end)
    end
end)

readyEvent.Event:Wait()

if guiDestroyed then
    return {}
end

return Hub
