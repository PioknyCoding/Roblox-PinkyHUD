    local function doReopen()
        minimized = false; Main.Visible = true
        Main.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0); Main.BackgroundTransparency = 0.4; Main.Position = savedPosition
        TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = savedSize, BackgroundTransparency = 0 }):Play()
    end
    MinBtn.MouseButton1Click:Connect(doMinimize)
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then if minimized then doReopen() else doMinimize() end end
    end)
        -- Opening animation (same as doReopen)
    Main.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0)
    Main.BackgroundTransparency = 0.4
    Main.Position = savedPosition
    TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = savedSize,
        BackgroundTransparency = 0
    }):Play()
end

