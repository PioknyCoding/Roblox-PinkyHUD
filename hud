    local height = 38
    if description then height = 52 end

    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(width, 0, 0, height), Parent = page })
    corner(wrap, 6)
    padding(wrap, 0, 0, 12, 12)
    makeTextBlock(wrap, text, description, 50)

    local trackColor = Theme.ToggleOff
    if state then trackColor = Theme.Accent end

    local track = make("TextButton", {
        BackgroundColor3 = trackColor, BorderSizePixel = 0, Size = UDim2.new(0, 38, 0, 18),
        Position = UDim2.new(1, -38, 0.5, -9), AutoButtonColor = false, Text = "", Parent = wrap,
    })
    corner(track, 3)

    local knobScale = 0
    local knobOffset = 2
    if state then
        knobScale = 1
        knobOffset = -14
    end

    local knob = make("Frame", {
        BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(knobScale, knobOffset, 0.5, -6), Parent = track,
    })
    corner(knob, 2)

    local function setState(on)
        state = on

        local newTrackColor = Theme.ToggleOff
        local newKnobScale = 0
        local newKnobOffset = 2
        if on then
            newTrackColor = Theme.Accent
            newKnobScale = 1
            newKnobOffset = -14
        end

        TweenService:Create(track, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { BackgroundColor3 = newTrackColor }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Position = UDim2.new(newKnobScale, newKnobOffset, 0.5, -6) }):Play()

        if callback then callback(state) end
    end

    track.MouseButton1Click:Connect(function() setState(not state) end)
    wrap.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setState(not state)
        end
    end)
    fade(wrap, Theme.ButtonHover)

    return wrap, setState
end

function Hub.NewSlider(page, text, min, max, default, callback, description)
    local height = 52
    if description then height = 70 end

    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), Parent = page })
    corner(wrap, 6)
    padding(wrap, 8, 8, 12, 12)

    local topRow = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = wrap })
    make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, 0),
        Font = Fonts.Medium, Text = text, TextColor3 = Theme.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = topRow,
    })

    local startValue = default
    if startValue == nil then startValue = min end

    local valueLbl = make("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(1, -38, 0, 0), Size = UDim2.new(0, 38, 0, 18),
        Font = Fonts.Bold, Text = tostring(startValue), TextColor3 = Theme.Accent, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = topRow,
    })

    local trackY = 22
    if description then
        make("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 18),
            Font = Fonts.Regular, Text = description, TextColor3 = Theme.TextDim, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            AutomaticSize = Enum.AutomaticSize.Y, Parent = wrap,
        })
        trackY = 36
    end

    local trackArea = make("TextButton", {
        BackgroundTransparency = 1, AutoButtonColor = false, Text = "",
        Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, trackY), Parent = wrap,
    })
    local track = make("Frame", {
        BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.5, -2), Parent = trackArea,
    })
    corner(track, 2)
    local fill = make("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = track })
    corner(fill, 2)
    local knob = make("Frame", {
        BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, -6, 0.5, -6), Parent = trackArea,
    })
    corner(knob, 2)

    local current = startValue

    local function setVal(v)
        current = math.clamp(v, min, max)
        local pct = (current - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -6, 0.5, -6)
        valueLbl.Text = tostring(math.floor(current))
        if callback then callback(current) end
    end

    local function pctFromInput(input)
        return math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    end

    local sliding = false
    trackArea.MouseButton1Down:Connect(function()
        sliding = true
        setVal(min + pctFromInput(UserInputService:GetMouseLocation()) * (max - min))
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setVal(min + pctFromInput(i) * (max - min))
        end
    end)

    setVal(current)

    return wrap, setVal
end

function Hub.NewDropdown(page, text, options, default, callback, description)
    local selected = default
    if selected == nil then selected = options[1] end

    local height = 38
    if description then height = 52 end

    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), Parent = page })
    corner(wrap, 6)
    padding(wrap, 0, 0, 12, 12)
    makeTextBlock(wrap, text, description, 120)

    local btn = make("TextButton", {
        BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
        Position = UDim2.new(1, -110, 0.5, -14), Size = UDim2.new(0, 110, 0, 28),
        Font = Fonts.Medium, Text = selected, TextColor3 = Theme.Text, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center, AutoButtonColor = false, Parent = wrap,
    })
    corner(btn, 4)

    local listContainer
    local open = false
    local followConn

    local function closeList()
        if followConn then
            followConn:Disconnect()
            followConn = nil
        end
        if listContainer then
            listContainer:Destroy()
            listContainer = nil
        end
        open = false
    end

    local function positionList()
        if not listContainer then return end
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        listContainer.Position = UDim2.new(0, pos.X, 0, pos.Y + size.Y + 4)
    end

    -- Handler reads the option straight off the clicked instance's
    -- own .Text property -- never off a captured loop variable.
    local function onOptionClicked(optBtn)
        selected = optBtn.Text
        btn.Text = selected
        closeList()
        if callback then callback(selected) end
        notify("PinkyHud", "Selected: " .. selected)
    end

    local function openList()
        closeList()

        local maxVisible = 5
        local itemHeight = 30
        local visibleCount = #options
        if visibleCount > maxVisible then visibleCount = maxVisible end
        local listHeight = visibleCount * itemHeight

        listContainer = make("Frame", {
            Name = "DropdownList", BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
            Size = UDim2.new(0, math.max(btn.AbsoluteSize.X, 110), 0, listHeight),
            ClipsDescendants = true, ZIndex = 999, Parent = ScreenGui,
        })
        corner(listContainer, 6)
        stroke(listContainer, Theme.Border, 1, 0.2)

        local scrollFrame = make("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0),
            ScrollBarThickness = 6, ScrollBarImageColor3 = Theme.Accent,
            ScrollBarImageTransparency = 0, CanvasSize = UDim2.new(0, 0, 0, #options * itemHeight),
            ClipsDescendants = true, ZIndex = 1000, Parent = listContainer,
        })

        local layout = make("UIListLayout", {
            Padding = UDim.new(0, 0), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scrollFrame,
        })

        for i = 1, #options do
            local optBtn = make("TextButton", {
                Name = "Opt_" .. i,
                BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, itemHeight), Font = Fonts.Regular,
                Text = options[i], TextColor3 = Theme.Text, TextSize = 12,
                AutoButtonColor = false, ZIndex = 1001, Parent = scrollFrame,
            })
            corner(optBtn, 4)
            fade(optBtn, Theme.ButtonHover)
        end

        -- MouseButton1Click fires with ZERO arguments in Roblox -- it
        -- does NOT pass the clicked instance. Rather than connecting a
        -- per-button closure (which needs a fresh capture per loop
        -- iteration and is the exact pattern obfuscators most often
        -- mangle), use a single shared handler on the scrolling frame
        -- that hit-tests the click position against each option's
        -- on-screen bounds. No per-item closures at all.
        scrollFrame.InputBegan:Connect(function(input)
            local isClick = input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            if not isClick then return end

            local clickPos = input.Position
            for _, child in ipairs(scrollFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    local pos = child.AbsolutePosition
                    local size = child.AbsoluteSize
                    local withinX = clickPos.X >= pos.X and clickPos.X <= pos.X + size.X
                    local withinY = clickPos.Y >= pos.Y and clickPos.Y <= pos.Y + size.Y
                    if withinX and withinY then
                        onOptionClicked(child)
                        break
                    end
                end
            end
        end)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
        end)

        positionList()
        followConn = RunService.Heartbeat:Connect(positionList)
        open = true
    end

    btn.MouseButton1Click:Connect(function()
        if open then
            closeList()
        else
            openList()
        end
    end)

    fade(btn, Theme.ButtonHover)

    page.AncestryChanged:Connect(function()
        if not page.Parent then
            closeList()
        end
    end)

    return wrap, btn
end

function Hub.NewKeybind(page, text, defaultKey, callback, description)
    local currentKey = defaultKey
    if currentKey == nil then currentKey = Enum.KeyCode.E end

    local height = 38
    if description then height = 52 end

    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), Parent = page })
    corner(wrap, 6)
    padding(wrap, 0, 0, 12, 12)
    makeTextBlock(wrap, text, description, 80)

    local btn = make("TextButton", {
        BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Position = UDim2.new(1, -68, 0.5, -14),
        Size = UDim2.new(0, 68, 0, 28), Font = Fonts.Bold, Text = currentKey.Name,
        TextColor3 = Theme.Accent, TextSize = 12, AutoButtonColor = false, Parent = wrap,
    })
    corner(btn, 4)

    local listening = false

    btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "..."
        btn.TextColor3 = Theme.TextDim
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            btn.Text = currentKey.Name
            btn.TextColor3 = Theme.Accent
            listening = false
            notify("PinkyHud", "Keybind set: " .. currentKey.Name)
            return
        end
        if gp then return end
        if input.KeyCode == currentKey and not listening then
            if callback then callback() end
        end
    end)

    fade(btn, Theme.ButtonHover)

    return wrap, btn
end

