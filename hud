local AUTH_KEY = getAuthKey()

local function loadSavedKey()
    ensureKeyFolder()
    local ok, content = pcall(function() return readfile(SAVED_KEY_FILE) end)
    if ok and content and content ~= "" then return (content:gsub("%s+", "")) end
    return nil
end

local function saveKey(key)
    ensureKeyFolder()
    pcall(function() writefile(SAVED_KEY_FILE, key) end)
end

