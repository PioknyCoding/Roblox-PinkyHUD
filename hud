--======================== HELPERS ========================--
local function make(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end
local function corner(p, r) return make("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = p }) end
local function stroke(p, c, t, tr)
    return make("UIStroke", { Color = c or Theme.Stroke, Thickness = t or 1, Transparency = tr or 0, Parent = p })
end
local function padding(p, t, b, l, r)
    return make("UIPadding", { PaddingTop = UDim.new(0,t or 0), PaddingBottom = UDim.new(0,b or 0), PaddingLeft = UDim.new(0,l or 0), PaddingRight = UDim.new(0,r or 0), Parent = p })
end
local function fade(btn, hoverColor)
    local normal = btn.BackgroundColor3
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { BackgroundColor3 = hoverColor }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { BackgroundColor3 = normal }):Play()
    end)
end
local function drawX(parent, color, size)
    local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, size, 0, size), Parent = parent })
    holder.AnchorPoint = Vector2.new(0.5, 0.5); holder.Position = UDim2.new(0.5, 0, 0.5, 0)
    for _, rot in ipairs({45, -45}) do
        make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, size, 0, 1.6), Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = rot, Parent = holder })
    end
    return holder
end
local function drawLine(parent, color, w, h)
    local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, w, h), Parent = parent })
    holder.AnchorPoint = Vector2.new(0.5, 0.5); holder.Position = UDim2.new(0.5, 0, 0.5, 0)
    make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = holder })
    return holder
end

-- Hamburger icon: 3 horizontal lines, top = smallest, middle = medium, bottom = largest
local function drawResizeIcon(parent, color, size)
    local holder = make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(0, size, 0, size),
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Parent = parent,
    })

    local thick = 2
    local maxLen = math.floor(size * 0.6)   -- largest line (bottom)
    local gap = math.floor(size * 0.22)     -- vertical spacing

    -- Line lengths from bottom to top: largest, medium, smallest
    local lengths = {
        maxLen,                      -- bottom (i=1)
        math.floor(maxLen * 0.75),  -- middle (i=2)
        math.floor(maxLen * 0.5),   -- top (i=3)
    }

    for i = 1, 3 do
        local yOffset = (i - 2) * gap   -- -gap, 0, gap (bottom to top)
        make("Frame", {
            BackgroundColor3 = color, BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, yOffset),
            Size = UDim2.new(0, lengths[i], 0, thick),   -- now bottom gets largest
            Rotation = 0,
            Parent = holder,
        })
    end
end

