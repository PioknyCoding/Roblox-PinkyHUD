        ZIndex = 70, Parent = Footer,
    })
    corner(ResizeHandle, 5)
    local resizeIcon = drawResizeIcon(ResizeHandle, Theme.TextDim, 18)

    local function setHandleColor(c)
        for _, bar in ipairs(resizeIcon:GetChildren()) do
            if bar:IsA("Frame") and bar.BackgroundTransparency == 0 then
                TweenService:Create(bar, TweenInfo.new(0.15), { BackgroundColor3 = c }):Play()
            end
        end
    end

    ResizeHandle.MouseEnter:Connect(function()
        setHandleColor(Theme.Accent)
        TweenService:Create(ResizeHandle, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ButtonHover }):Play()
    end)
    ResizeHandle.MouseLeave:Connect(function()
        setHandleColor(Theme.TextDim)
        TweenService:Create(ResizeHandle, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Button }):Play()
    end)

    make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(1, -12, 0, 0), AnchorPoint = Vector2.new(1, 0),
        Font = Fonts.Black, Text = "Scripted By: Piokny", TextColor3 = Theme.Accent, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right, Parent = Footer,
    })

    local resizing, resizeStart, resizeStartSize, resizeStartPos

    ResizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            resizeStartSize = Main.AbsoluteSize
            resizeStartPos = Main.AbsolutePosition
            setHandleColor(Theme.Accent)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - resizeStart
            local newW = math.clamp(resizeStartSize.X - d.X, 440, 1100)
            local newH = math.clamp(resizeStartSize.Y + d.Y, 320, 800)
            Main.Position = UDim2.new(0, resizeStartPos.X + (resizeStartSize.X - newW), 0, resizeStartPos.Y)
            Main.Size = UDim2.new(0, newW, 0, newH)
        end
    end)

    local function doMinimize()
        minimized = true
        savedSize = Main.Size
        savedPosition = Main.Position
        TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0), BackgroundTransparency = 1 }):Play()
        task.delay(0.2, function()
            Main.Visible = false
            Main.BackgroundTransparency = 0
        end)
        notify("PinkyHud", "Minimized -- press RightShift to reopen", 4)
    end

    local function doReopen()
        minimized = false
        Main.Visible = true
        Main.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0)
        Main.BackgroundTransparency = 0.4
        Main.Position = savedPosition
        TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = savedSize, BackgroundTransparency = 0 }):Play()
    end

    MinBtn.MouseButton1Click:Connect(doMinimize)
    rightShiftConn = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.RightShift then
            if minimized then
                doReopen()
            else
                doMinimize()
            end
        end
    end)

    Main.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, 0)
    Main.BackgroundTransparency = 0.4
    Main.Position = savedPosition
    TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = savedSize,
        BackgroundTransparency = 0,
    }):Play()
end

