    make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
        Font = Fonts.Black, Text = toastTitle, TextColor3 = Theme.Text, TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = textHolder,
    })

    if message then
        make("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14),
            Font = Fonts.Regular, Text = message, TextColor3 = Theme.TextDim, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            AutomaticSize = Enum.AutomaticSize.Y, Parent = textHolder,
        })
    end

    toast.ClipsDescendants = true
    TweenService:Create(toast, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 240, 0, 60) }):Play()

    task.delay(dur, function()
        local out = TweenService:Create(toast, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 240, 0, 0), BackgroundTransparency = 1 })
        out:Play()
        out.Completed:Connect(function() toast:Destroy() end)
    end)
end

