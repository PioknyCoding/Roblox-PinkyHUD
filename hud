local function notify(title, message, duration)
    if not hudActive then return end

    local dur = duration
    if dur == nil then dur = 3 end

    local toastTitle = title
    if toastTitle == nil then toastTitle = "PinkyHud" end

    local toast = make("Frame", {
        BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0,
        Size = UDim2.new(0, 240, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = ToastContainer,
