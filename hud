local function selectTab(name)
    for n, btn in pairs(Tabs) do
        local active = (n == name)

        local bgColor = Theme.Sidebar
        local textColor = Theme.TextDim
        local indicatorTrans = 1
        if active then
            bgColor = Theme.ButtonHover
            textColor = Theme.Accent
            indicatorTrans = 0
        end

        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = bgColor, TextColor3 = textColor }):Play()
        btn.Indicator.BackgroundTransparency = indicatorTrans
    end
    for n, page in pairs(Pages) do
        page.Visible = (n == name)
    end
end

