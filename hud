function Hub.NewToggle(page, text, default, callback, widthScale, description)
    local state = default or false
    local height = description and 52 or 38
    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(widthScale or 1, 0, 0, height), Parent = page })
