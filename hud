        end
    end)
    DragBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - dragStart
            local vp = workspace.CurrentCamera.ViewportSize
            local ws = Main.AbsoluteSize
            Main.Position = UDim2.new(
                0, math.clamp(startPos.X.Offset + d.X, -ws.X + 80, vp.X - 80),
                0, math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - 40)
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local Footer = make("Frame", {
        Name = "Footer", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -28),
        BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, ZIndex = 60, Parent = Main,
