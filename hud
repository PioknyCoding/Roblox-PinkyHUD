    corner(Footer, 10)
    make("Frame", { Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Theme.Topbar, BorderSizePixel = 0, Parent = Footer })

