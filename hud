function Hub.NewSlider(page, text, min, max, default, callback, description)
    local height = description and 70 or 52
    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), Parent = page })
    corner(wrap, 6); padding(wrap, 8, 8, 12, 12)
    local topRow = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = wrap })
    make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, 0), Font = Fonts.Medium, Text = text, TextColor3 = Theme.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = topRow })
    local valueLbl = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(1, -38, 0, 0), Size = UDim2.new(0, 38, 0, 18), Font = Fonts.Bold, Text = tostring(default or min), TextColor3 = Theme.Accent, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Parent = topRow })
    local trackY = 22
    if description then make("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 18), Font = Fonts.Regular, Text = description, TextColor3 = Theme.TextDim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Parent = wrap }); trackY = 36 end
    local trackArea = make("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, trackY), Parent = wrap })
    local track = make("Frame", { BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), Parent = trackArea })
    corner(track, 2)
    local fill = make("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = track })
    corner(fill, 2)
    local knob = make("Frame", { BackgroundColor3 = Theme.Text, BorderSizePixel = 0, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, -6, 0.5, -6), Parent = trackArea })
    corner(knob, 2)
    local current = default or min
    local function setVal(v) current = math.clamp(v, min, max); local pct = (current - min) / (max - min); fill.Size = UDim2.new(pct, 0, 1, 0); knob.Position = UDim2.new(pct, -6, 0.5, -6); valueLbl.Text = tostring(math.floor(current)); if callback then callback(current) end end
    local function pctFromInput(input) return math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) end
    local sliding = false
    trackArea.MouseButton1Down:Connect(function() sliding = true; setVal(min + pctFromInput(UserInputService:GetMouseLocation()) * (max - min)) end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
    UserInputService.InputChanged:Connect(function(i) if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setVal(min + pctFromInput(i) * (max - min)) end end)
    setVal(current)
    return wrap, setVal
end
function Hub.NewDropdown(page, text, options, default, callback, description)
    local selected = default or options[1]
    local height = description and 52 or 38
    local wrap = make("Frame", { BackgroundColor3 = Theme.Button, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), Parent = page })
    corner(wrap, 6); padding(wrap, 0, 0, 12, 12); makeTextBlock(wrap, text, description, 120)

    local btn = make("TextButton", {
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -110, 0.5, -14),
        Size = UDim2.new(0, 110, 0, 28),
        Font = Fonts.Medium,
        Text = selected,
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        AutoButtonColor = false,
        Parent = wrap,
    })
    corner(btn, 4)

    local listContainer = nil
    local open = false
    local positionUpdater = nil  -- RenderStepped connection

    local function closeList()
        if positionUpdater then
            positionUpdater:Disconnect()
            positionUpdater = nil
        end
        if listContainer then
            listContainer:Destroy()
            listContainer = nil
            open = false
        end
    end

    local function openList()
        closeList() -- ensure clean state

        -- Wait a tiny bit for layout to update so AbsolutePosition is correct
        task.wait(0.01)

        local btnAbsPos = btn.AbsolutePosition
        local btnSize = btn.AbsoluteSize

        -- Prevent spawning off-screen if button isn't ready
        if btnAbsPos.X == 0 and btnAbsPos.Y == 0 then
            btnAbsPos = btn.Parent:FindFirstAncestorOfClass("Frame").AbsolutePosition
        end

        local xPos = btnAbsPos.X
        local yPos = btnAbsPos.Y + btnSize.Y + 4

        local maxVisible = 5
        local itemHeight = 30
        local listHeight = math.min(#options, maxVisible) * itemHeight
        local hasScroll = #options > maxVisible

        -- Create the list container (parented to ScreenGui to avoid clipping)
        listContainer = make("Frame", {
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            Size = UDim2.new(0, math.max(btnSize.X, 110), 0, listHeight),
            Position = UDim2.new(0, xPos, 0, yPos),
            ClipsDescendants = true,
            ZIndex = 999,
            Parent = ScreenGui,
        })
        corner(listContainer, 6)
        stroke(listContainer, Theme.Border, 1, 0.2)

        -- ScrollingFrame
        local scrollFrame = make("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Border,
            CanvasSize = UDim2.new(0, 0, 0, #options * itemHeight),
            ClipsDescendants = true,
            ZIndex = 1000,
            Parent = listContainer,
        })

        local layout = make("UIListLayout", {
            Padding = UDim.new(0, 0),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = scrollFrame,
        })

        -- Add options
        for _, opt in ipairs(options) do
            local optBtn = make("TextButton", {
                BackgroundColor3 = Theme.Background,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, itemHeight),
                Font = Fonts.Regular,
                Text = opt,
                TextColor3 = Theme.Text,
                TextSize = 12,
                AutoButtonColor = false,
                ZIndex = 1001,
                Parent = scrollFrame,
            })
            corner(optBtn, 4)
            fade(optBtn, Theme.ButtonHover)
            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                btn.Text = opt
                closeList()
                if callback then callback(opt) end
                notify("PinkyHud", "Selected: " .. opt)
            end)
        end

        -- Update canvas size
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
        end)

        open = true

        -- ✅ CRITICAL: Keep the dropdown glued to the button when the UI moves
        positionUpdater = RunService.RenderStepped:Connect(function()
            if not listContainer or not listContainer.Parent then
                if positionUpdater then positionUpdater:Disconnect() end
                positionUpdater = nil
                return
            end
            -- Update position to follow the button
            local newPos = btn.AbsolutePosition
            listContainer.Position = UDim2.new(0, newPos.X, 0, newPos.Y + btn.AbsoluteSize.Y + 4)
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if open then
            closeList()
        else
            openList()
        end
    end)

    fade(btn, Theme.ButtonHover)

    -- Cleanup if the page is destroyed
    page.AncestryChanged:Connect(function()
        if not page.Parent then
            closeList()
        end
    end)

    return wrap, btn
end
