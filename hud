local function selectTab(name)
    for n, btn in pairs(Tabs) do
        local active = (n == name)
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = active and Theme.ButtonHover or Theme.Sidebar, TextColor3 = active and Theme.Accent or Theme.TextDim }):Play()
        btn.Indicator.BackgroundTransparency = active and 0 or 1
    end
    for n, page in pairs(Pages) do page.Visible = (n == name) end
end

local function addTab(name)
    local btn = make("TextButton", { BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 34), Font = Fonts.Medium, Text = "   " .. name, TextColor3 = Theme.TextDim, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, Parent = TabList })
