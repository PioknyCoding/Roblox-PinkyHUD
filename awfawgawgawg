local function setField(target, key, value)
    local tries = {
        function() target[key] = value end,
        function() if sethiddenprop then sethiddenprop(target, key, value) end end,
        function() if sethiddenproperty then sethiddenproperty(target, key, value) end end,
        function() if syn and syn.set_hidden_prop then syn.set_hidden_prop(target, key, value) end end,
        function() if getgenv and getgenv().sethiddenprop then getgenv().sethiddenprop(target, key, value) end end,
    }
    for _, fn in ipairs(tries) do
        local ok = pcall(fn)
        if ok then return true end
    end
    return false
end

local function setStreamingValues()
    setField(Workspace, "StreamingMinRadius", 256)
    setField(Workspace, "StreamingTargetRadius", 2048)
    pcall(function()
        if Workspace.StreamingEnabled ~= true then
            Workspace.StreamingEnabled = true
        end
    end)
end

local function askForStream(pos, timeout)
