end

local function makeFocusPart(pos)
    local part = Instance.new("Part")
    part.Name = "MapLoadFocus"
    part.Size = Vector3.new(4, 4, 4)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Position = pos + Vector3.new(0, 2, 0)
    part.Parent = Workspace
    return part
end

local function setLoadFocus(part)
    return setField(player, "ReplicationFocus", part)
end

local function clearLoadFocus()
    pcall(function()
        player.ReplicationFocus = nil
    end)
    setField(player, "ReplicationFocus", nil)
end

local function moveCameraAlong(startCFrame, endCFrame, startPos, endPos, duration)
    local camera = Workspace.CurrentCamera
    camera.CFrame = startCFrame
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local camTween = TweenService:Create(camera, tweenInfo, {CFrame = endCFrame})
    local focusPart = makeFocusPart(startPos)
    setLoadFocus(focusPart)
    local streamThread = task.spawn(function()
        for step = 1, 8 do
            local alpha = step / 8
            local samplePos = startPos + (endPos - startPos) * alpha
            focusPart.Position = samplePos + Vector3.new(0, 2, 0)
            setLoadFocus(focusPart)
            for attempt = 1, 2 do
                askForStream(samplePos + Vector3.new(0, 0, (attempt - 1) * 10), 10)
            end
            task.wait(duration / 8)
        end
    end)
    camTween:Play()
    camTween.Completed:Wait()
    task.wait(0.02)
    focusPart:Destroy()
    task.wait(0.01)
end

local function runMapLoad()
    local camera = Workspace.CurrentCamera
    local originalCameraType = camera.CameraType
    local originalCameraSubject = camera.CameraSubject
    local originalCFrame = camera.CFrame
    setStreamingValues()
    camera.CameraType = Enum.CameraType.Scriptable
    local loadPoints = {
        {pos = Vector3.new(-168, 58, -3803)},
        {pos = Vector3.new(437, 55, -3618)},
        {pos = Vector3.new(1011, 64, -507)},
        {pos = Vector3.new(818, 54, 448)},
    }
    local focusParts = {}
    local startCFrame = camera.CFrame
    for _, point in ipairs(loadPoints) do
        local targetPos = point.pos
        local lookAt = targetPos + Vector3.new(0, 4, 0)
        local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 20, -36), lookAt)
        moveCameraAlong(startCFrame, targetCFrame, startCFrame.Position, targetPos, 0.2)
        local focusPart = makeFocusPart(targetPos)
        table.insert(focusParts, focusPart)
        setLoadFocus(focusPart)
        for attempt = 1, 3 do
            askForStream(targetPos + Vector3.new(0, 0, (attempt - 1) * 16), 10)
        end
        startCFrame = camera.CFrame
        task.wait(0.01)
    end
    camera.CFrame = originalCFrame
    camera.CameraType = originalCameraType
    camera.CameraSubject = originalCameraSubject
    for _, focusPart in ipairs(focusParts) do
        if focusPart and focusPart.Parent then
            focusPart:Destroy()
        end
    end
    clearLoadFocus()
    print("Map load complete")
end

