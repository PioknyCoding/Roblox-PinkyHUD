local hasRobbedPowerPlant = false

-- Anti-stuck watchdog
task.spawn(function()
    local anchorPos = nil
    local stuckTimer = 0
    local requiredEscapeRadius = 5
    while true do
        task.wait(2)
        local root = getRoot()
        if root then
            local currentPos = root.Position
            if not anchorPos then
                anchorPos = currentPos
            end
            local distFromAnchor = (currentPos - anchorPos).Magnitude
            if distFromAnchor < requiredEscapeRadius then
                stuckTimer = stuckTimer + 2
            else
                stuckTimer = 0
                anchorPos = currentPos
            end
            if stuckTimer >= 15 then
                local isSafeZone = false
                if (currentPos - Vector3.new(1245, 68, -4827)).Magnitude < 30 then
                    isSafeZone = true
                end
                if (currentPos - Vector3.new(1689, 75, -2054)).Magnitude < 30 then
                    isSafeZone = true
                end
                if currentPos.Y < -150 and currentPos.Z < -4600 and currentPos.Z > -4900 then
                    isSafeZone = true
                end
                if currentPos.X > 450 and currentPos.X < 750 and currentPos.Z > 2500 and currentPos.Z < 2800 then
                    isSafeZone = true
                end
                if currentPos.Y > 200 then
                    isSafeZone = true
                end
                if not isSafeZone then
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        if obj.Name == "Drop" and obj:IsA("Model") then
                            local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if p and (p.Position - currentPos).Magnitude < 150 then
                                isSafeZone = true
                                break
                            end
                        end
                    end
                end
                if not isSafeZone then
                    showNotification("Script stuck detected. Hopping servers...")
                    stuckTimer = 0
                    anchorPos = nil
                    serverhop()
                    task.wait(10)
                else
                    stuckTimer = 0
                    anchorPos = currentPos
                end
            end
        end
    end
end)

local function mainLoop()
    while true do
        local mansionStatus = getRawRobberyStatus("Mansion")
        local mansionInvites = player:GetAttribute("MansionInvites") or 0
        local timeSinceLast = os.time() - _G.lastAirdropTime

        if mansionStatus == 1 and mansionInvites > 0 then
            if processMansion() then task.wait(5); continue end
        end

        if timeSinceLast >= 300 then
            if processAirdrop() then task.wait(5); continue end
        end

        if not hasRobbedPowerPlant then
            if processPowerPlant() then
                hasRobbedPowerPlant = true
                task.wait(5)
                continue
            end
        end

        showNotification("No options – hopping servers")
        serverhop()
        task.wait(10)
    end
end

