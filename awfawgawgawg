-- CAR SPAWN & ENTER (with cop avoidance)
--==================================================================================
local free_vehicles = { Camaro = true }
local unsupported_vehicles = { SWATVan = true }

local function getNearestEnterableOwnedVehicle()
    local nearest = nil
    local nearestDist = math.huge
    local myRoot = getRoot()
    if not myRoot then return nil end

    for _, action in pairs(CircleAction.Specs) do
        if action.IsVehicle and action.ShouldAllowEntry == true and action.Enabled == true and action.Name == "Enter Driver" then
            local vehicle = action.ValidRoot
            if vehicle then
                if not unsupported_vehicles[vehicle.Name] and (store._state.garageOwned.Vehicles[vehicle.Name] or free_vehicles[vehicle.Name]) then
                    local seat = vehicle:FindFirstChild("Seat")
                    if seat and not seat.Player.Value then
                        local dist = (seat.Position - myRoot.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = action
                        end
                    end
                end
            end
        end
    end
    return nearest, nearestDist
end

local function spawnCamaro()
    ReplicatedStorage:WaitForChild("GarageSpawnVehicle"):FireServer("Chassis", "Camaro")
end

local function enterVehicle(action)
    if not action then return false end
    local vehicle = action.ValidRoot
    local seat = vehicle and vehicle:FindFirstChild("Seat")
    if not seat then return false end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local seatPos = seat.Position
    local hrpPos = hrp.Position

    -- Always go straight up 20 studs, then over, then down
    local upPos = hrpPos + Vector3.new(0, 20, 0)
    local aboveSeat = seatPos + Vector3.new(0, 20, 0)

    local h = getHuman()
    if h then h.PlatformStand = true end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local TWEEN_SPD = 250

    -- 1. Up
    while true do
        local root = getRoot()
        if not root then bv:Destroy(); if h then h.PlatformStand = false end; return false end
        local diff = upPos - root.Position
        if diff.Magnitude < 4 then bv.Velocity = Vector3.zero break end
        bv.Velocity = diff.Unit * TWEEN_SPD
        task.wait()
    end

    -- 2. Horizontal to above seat
    while true do
        local root = getRoot()
        if not root then bv:Destroy(); if h then h.PlatformStand = false end; return false end
        local diff = aboveSeat - root.Position
        if diff.Magnitude < 6 then bv.Velocity = Vector3.zero break end
        bv.Velocity = diff.Unit * TWEEN_SPD
        task.wait()
    end

    -- 3. Straight down to seat
    while true do
        local root = getRoot()
        if not root then bv:Destroy(); if h then h.PlatformStand = false end; return false end
        local diff = seatPos - root.Position
        if diff.Magnitude < 4 then bv.Velocity = Vector3.zero break end
        bv.Velocity = diff.Unit * TWEEN_SPD
        task.wait()
    end

    bv:Destroy()
    if h then h.PlatformStand = false end

    -- Snap to seat
    hrp = getRoot()
    if hrp then hrp.CFrame = seat.CFrame end

    -- Attempt to enter
    for attempt = 1, 10 do
        action:Callback(true)
        task.wait(0.1)
        if isInCar() then return true end
    end
    return false
end

local function escapePrison()
    showNotification("Escaping prison...")
    local r = getRoot()
    if not r then return false end
    local startPos = r.Position
    local h = getHuman()
    if h then h.PlatformStand = true end
    local bvUp = Instance.new("BodyVelocity")
    bvUp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bvUp.Velocity = Vector3.zero
    bvUp.Parent = r
    local upTarget = startPos + Vector3.new(0, 300, 0)
    while true do
        local root = getRoot()
        if not root then bvUp:Destroy(); return false end
        local diff = upTarget - root.Position
        if diff.Magnitude < 8 then bvUp.Velocity = Vector3.zero break end
        bvUp.Velocity = diff.Unit * 100
        task.wait()
    end
    local downTarget = startPos
    while true do
        local root = getRoot()
        if not root then bvUp:Destroy(); return false end
        local diff = downTarget - root.Position
        if diff.Magnitude < 8 then bvUp.Velocity = Vector3.zero break end
        bvUp.Velocity = diff.Unit * 100
        task.wait()
    end
    bvUp:Destroy()
    if h then h.PlatformStand = false end
    task.wait(0.3)
    return true
end

local function ensureInCar()
    if isInCar() then return true end

    if isPrisoner() then
        local escapeAttempts = 0
        while isPrisoner() and escapeAttempts < 3 do
            escapeAttempts = escapeAttempts + 1
            escapePrison()
            task.wait(2)
            if not isPrisoner() then break end
            showNotification("Escape failed, retrying...", 2)
        end
        if isPrisoner() then
            showNotification("Could not escape prison. Hopping.")
            serverhop()
            task.wait(10)
            return false
        end
    end

    while isCopNearby(40) do
        showNotification("Cop nearby – moving away", 2)
        if not moveAwayFromCops() then
            showNotification("Failed to move from cop")
            return false
        end
        task.wait(1)
    end

    local MAX_TWEEN_DIST = 300
    local action, dist = getNearestEnterableOwnedVehicle()
    if action and dist and dist > MAX_TWEEN_DIST then action = nil end

    local spawnAttempts = 0
    while spawnAttempts < 3 do
        if not action then
            showNotification("Spawning Camaro...")
            spawnCamaro()
            local waited = 0
            while waited < 8 do
                task.wait(0.5)
                waited = waited + 0.5
                if isInCar() then
                    showNotification("Camaro ready")
                    return true
                end
                action, dist = getNearestEnterableOwnedVehicle()
                if action then break end
            end
        end
        if action then
            showNotification("Entering vehicle")
            if enterVehicle(action) then
                local seated = false
                for _ = 1, 10 do
                    if isInCar() then seated = true; break end
                    task.wait(0.2)
                end
                if seated then
                    showNotification("In car")
                    return true
                end
            end
            showNotification("Entry failed, retrying...")
            action = nil
        end
        spawnAttempts = spawnAttempts + 1
        task.wait(1)
    end

    showNotification("Failed to get in car.")
    return false
end

local function exitCurrentVehicle()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local seatPart = nil
    for _, weld in ipairs(root:GetChildren()) do
        if weld:IsA("Weld") and weld.Part1 and weld.Part1.Name == "Seat" then
            seatPart = weld.Part1
            break
        end
    end
    if not seatPart then return end
    local playerNameValue = seatPart:FindFirstChild("PlayerName")
    local CharacterUtil = require(ReplicatedStorage.Game.CharacterUtil)
    local startTime = os.clock()
    repeat
        task.wait(0.15)
        pcall(function() CharacterUtil.OnJump() end)
        if os.clock() - startTime > 5 then
            for _, weld in ipairs(root:GetChildren()) do
                if weld:IsA("Weld") then weld:Destroy() end
            end
            break
        end
    until not playerNameValue or playerNameValue.Value ~= player.Name
end

