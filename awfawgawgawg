        threshold = threshold or 8
        speed = speed or 150
        local stuckTimer = 0
        local lastPos = rootPart.Position
        while running do
            local root = getRoot()
            if not root then cleanup(); return end
            local diff = target - root.Position
            if diff.Magnitude < threshold then
                bv.Velocity = Vector3.zero
                break
            end
            local moved = (root.Position - lastPos).Magnitude
            if moved < 1 then
                stuckTimer = stuckTimer + 0.1
            else
                stuckTimer = 0
            end
            lastPos = root.Position
            if stuckTimer > 1.0 then
                bv.Velocity = (diff.Unit * speed) + Vector3.new(0, 20, 0)
            else
                bv.Velocity = diff.Unit * speed
            end
            task.wait(0.1)
        end
    end

    for _, wp in ipairs(preWaitWaypoints) do
        slowMoveTo(wp, 8, 150)
        task.wait(0.1)
    end

    showNotification("Waiting for $6,450...")
    if waitForUraniumValue(30) then
        showNotification("Uranium value confirmed!")
    else
        showNotification("Value wait timed out – continuing")
    end

    for _, wp in ipairs(finalWaypoints) do
        slowMoveTo(wp, 8, 150)
        task.wait(0.1)
    end

    for _, wp in ipairs(upWaypoints) do
        slowMoveTo(wp, 8, 150)
        task.wait(0.1)
    end

    local safeHighPoint = rootPart.Position + Vector3.new(0, 500, 0)
    slowMoveTo(safeHighPoint, 15, 200)

    cleanup()
    return true
end

