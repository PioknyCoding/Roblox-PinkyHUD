local function getAirdropRemoteObjects(drop)
    if not drop then return nil end
    local press = drop:FindFirstChild("BriefcasePress")
    local holdUpdate = drop:FindFirstChild("BriefcaseHoldUpdate")
    local release = drop:FindFirstChild("BriefcaseRelease")
    local collect = drop:FindFirstChild("BriefcaseCollect")
    return { press = press, holdUpdate = holdUpdate, release = release, collect = collect }
end

local function fireAirdropRemote(obj, ...)
    if not obj or typeof(obj.FireServer) ~= "function" then return false end
    local args = { ... }
    local success, err = pcall(function() obj:FireServer(unpack(args)) end)
    if not success then warn("Airdrop remote failed:", err) end
    return success
end

--==================================================================================
-- AIRDROP HANDLING (remote-based reward)
--==================================================================================
local function processAirdrop()
    local myRoot = getRoot()
    if not myRoot then return false end

    local status = getRawRobberyStatus("Mansion")
    if status == 1 or status == 2 then
        return false
    end

    local nearestDrop = nil
    local nearestDist = math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Drop" then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (myRoot.Position - part.Position).Magnitude
                if d < nearestDist then
                    nearestDist = d
                    nearestDrop = obj
                end
            end
        end
    end
    if not nearestDrop then
        showNotification("No airdrop available")
        return false
    end

    showNotification("Waiting for airdrop to land...")
    local landingStart = os.clock()
    while os.clock() - landingStart < 30 do
        if not nearestDrop or not nearestDrop.Parent then return false end
        local primary = nearestDrop.PrimaryPart or nearestDrop:FindFirstChildWhichIsA("BasePart")
        if primary then
            local vel = primary.AssemblyLinearVelocity
            if vel.Magnitude < 2 then break end
        end
        task.wait(0.3)
    end

    local landingPart = nearestDrop:FindFirstChild("Handle") or nearestDrop.PrimaryPart or nearestDrop:FindFirstChildWhichIsA("BasePart")
    if not landingPart then return false end
    local dropCenter = landingPart.Position
    local dropTopY = dropCenter.Y + (landingPart.Size.Y / 2)
    local topSurfacePos = Vector3.new(dropCenter.X, dropTopY, dropCenter.Z)
    local sidePos = topSurfacePos + Vector3.new(48, 0, 0)

    if not ensureInCar() then
        showNotification("Car failed")
        return false
    end
    if not flyCarTo(sidePos) then
        showNotification("Car lost during flight, re-entering...")
        if not ensureInCar() then return false end
        if not flyCarTo(sidePos) then return false end
    end

    task.wait(0.5)
    exitCurrentVehicle()
    task.wait(0.3)

    local remotes = getAirdropRemoteObjects(nearestDrop)
    if not remotes then
        showNotification("Airdrop error")
        return false
    end

    local openSpec = nil
    for _, spec in pairs(CircleAction.Specs) do
        if spec.Name == "Open Crate" and spec.Part and spec.Part:IsDescendantOf(nearestDrop) then
            openSpec = spec
            break
        end
    end

    local function tweenToDrop(targetPos, speed)
        speed = speed or 60
        local char = player.Character
        if not char then return end
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = rootPart

        while true do
            local r = getRoot()
            if not r then bv:Destroy(); return end
            local diff = targetPos - r.Position
            if diff.Magnitude < 2 then
                bv.Velocity = Vector3.zero
                rootPart.CFrame = CFrame.new(targetPos)
                break
            end
            bv.Velocity = diff.Unit * speed
            task.wait()
        end
        bv:Destroy()
        if hum then hum.PlatformStand = false end
    end

    local abovePos = topSurfacePos + Vector3.new(0, 10, 0)
    tweenToDrop(abovePos, 80)
    local standPos = topSurfacePos + Vector3.new(0, 2, 0)
    tweenToDrop(standPos, 40)
    task.wait(0.5)

    showNotification("Opening airdrop...")

    local keepRunning = true

    local function doHoldCycle()
        if remotes.press and isFireableRemote(remotes.press) then
            fireAirdropRemote(remotes.press)
        end
        if openSpec and openSpec.Callback then
            pcall(function() openSpec.Callback(nil, true) end)
        end
        local holdStart = os.clock()
        while os.clock() - holdStart < 5 and keepRunning do
            if remotes.holdUpdate and isFireableRemote(remotes.holdUpdate) then
                fireAirdropRemote(remotes.holdUpdate)
            elseif remotes.press and isFireableRemote(remotes.press) then
                fireAirdropRemote(remotes.press)
            end
            task.wait(0.15)
        end
        if remotes.release and isFireableRemote(remotes.release) then
            fireAirdropRemote(remotes.release)
        end
        task.wait(0.2)
    end

    local holdThread = task.spawn(function()
        while keepRunning and nearestDrop and nearestDrop.Parent do
            doHoldCycle()
        end
    end)

    -- Wait for drop to disappear (or we decide to stop)
    local dropGone = false
    local waitStart = os.clock()
    while not dropGone do
        if not nearestDrop or not nearestDrop.Parent then
            dropGone = true
        else
            -- If drop still exists, we keep holding. But we also need a timeout to avoid infinite holding if the drop never despawns? In Jailbreak the drop does despawn, but we'll add a safety 60s max.
            if os.clock() - waitStart > 60 then
                showNotification("Airdrop hold timeout – stopping")
                break
            end
        end
        task.wait(0.2)
    end

    keepRunning = false
    if holdThread then task.cancel(holdThread) end
    if remotes.release and isFireableRemote(remotes.release) then
        fireAirdropRemote(remotes.release)
    end

    -- Now claim reward via remote
    if dropGone then
        -- Drop disappeared, fire the reward collector
        collectReward("AirDropOpen")
        _G.lastAirdropTime = os.time()
        saveCooldown(_G.lastAirdropTime)
        showNotification("Airdrop claimed – 5 min cooldown")
        return true
    else
        showNotification("Airdrop failed – no cooldown")
        return false
    end
end

--==================================================================================
-- TWEEN TO POINTS
--==================================================================================
local function tweenToPoints(points, speed, stopCheck)
    speed = speed or 120
    local char = player.Character
    if not char then return true end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = true
        hum.AutoRotate = false
    end

    for _, pos in ipairs(points) do
        if stopCheck and stopCheck() then
            if hum then hum.PlatformStand = false; hum.AutoRotate = true end
            return false
        end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bg.P = 1e4
        bg.CFrame = root.CFrame
        bg.Parent = root

        while true do
            if stopCheck and stopCheck() then
                bv:Destroy(); bg:Destroy()
                if hum then hum.PlatformStand = false; hum.AutoRotate = true end
                return false
            end
            local r = getRoot()
            if not r then bv:Destroy(); bg:Destroy(); return false end
            local diff = pos - r.Position
            local dist = diff.Magnitude
            if dist < 4 then
                bv.Velocity = Vector3.zero
                local targetDir = diff.Magnitude > 0.1 and diff.Unit or Vector3.new(0,0,-1)
                bg.CFrame = CFrame.lookAt(r.Position, r.Position + targetDir)
                break
            end
            local spd = math.min(speed, dist * 15)
            bv.Velocity = diff.Unit * spd
            local lookDir = diff.Unit * Vector3.new(1,0,1)
            if lookDir.Magnitude > 0.1 then
                bg.CFrame = CFrame.lookAt(r.Position, r.Position + lookDir)
            end
            task.wait()
        end
        bv:Destroy()
        bg:Destroy()
        root.CFrame = CFrame.new(pos)
        task.wait(0.05)
    end
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
    end
    return true
end

