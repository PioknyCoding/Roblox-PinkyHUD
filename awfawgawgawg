local function loadStats()
    local ok, content = pcall(function() return readfile(STATS_FILE) end)
    if ok and content and content ~= "" then
        local decoded = HttpService:JSONDecode(content)
        if decoded then
            stats.totalEarnings = decoded.totalEarnings or 0
