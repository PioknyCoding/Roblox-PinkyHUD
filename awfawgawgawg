local function slowMoveTo(bv, target, thresh, speed)
    thresh = thresh or 8
    speed = speed or 150
    local stuckTimer = 0
    local lastPos = getRoot() and getRoot().Position or Vector3.zero
    while true do
        if not State.autoPiloting then bv.Velocity = Vector3.zero break end
        local root = getRoot()
        if not root then State.autoPiloting = false break end
        local diff = target - root.Position
        if diff.Magnitude < thresh then bv.Velocity = Vector3.zero break end
        local moved = (root.Position - lastPos).Magnitude
        if moved < 1 then
            stuckTimer = stuckTimer + 0.1
        else
            stuckTimer = 0
        end
        lastPos = root.Position
        if stuckTimer > 1.0 then
            bv.Velocity = (diff.Unit * speed) + Vector3.new(0, 20, 0)
        else
            bv.Velocity = diff.Unit * speed
        end
        task.wait(0.1)
    end
end

