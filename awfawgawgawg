local function isCopNearby(radius)
    radius = radius or 40
    local root = getRoot()
    if not root then return false end
    local pos = root.Position
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("Police") or obj.Name:find("Officer") or obj.Name:find("Cop")) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part and (part.Position - pos).Magnitude < radius then
                    return true
                end
            end
        end
    end
    return false
end

local function moveAwayFromCops()
    local root = getRoot()
    if not root then return false end
    local pos = root.Position
    local target = pos + Vector3.new(0, 80, 0) + (CFrame.Angles(0, math.random() * 2 * math.pi, 0) * Vector3.new(60, 0, 0))
    showNotification("Cop nearby – moving away", 2)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local hum = getHuman()
    if hum then hum.PlatformStand = true end
    local speed = 150
    while true do
        local r = getRoot()
        if not r then bv:Destroy(); if hum then hum.PlatformStand = false end; return false end
        local diff = target - r.Position
        if diff.Magnitude < 10 then
            bv.Velocity = Vector3.zero
            break
        end
        bv.Velocity = diff.Unit * speed
        task.wait()
    end
    bv:Destroy()
    if hum then hum.PlatformStand = false end
    task.wait(0.5)
    return true
end

--==================================================================================
-- CAR MOVEMENTS WITH SAFETY
--==================================================================================
local vehicleFlySpeed = 400
local vehicleFlyEnabled = false
local vehicleFlyConnection = nil

local function getRootPart()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function stopVehicleFly()
    vehicleFlyEnabled = false
    if vehicleFlyConnection then
        vehicleFlyConnection:Disconnect()
        vehicleFlyConnection = nil
    end
    local root = getRootPart()
    if root then root.AssemblyLinearVelocity = Vector3.zero end
end

local function updateVehicleFly(delta)
    if not vehicleFlyEnabled then return end
    local root = getRootPart()
    if not root then
        stopVehicleFly()
        return
    end
    local cam = Workspace.CurrentCamera
    local forward = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0,1,0) end
    if move.Magnitude > 0 then
        move = move.Unit * vehicleFlySpeed
    end
    root.AssemblyLinearVelocity = move
    if move.Magnitude > 0.1 then
        local targetCFrame = CFrame.lookAt(root.Position, root.Position + move.Unit)
        root.CFrame = root.CFrame:Lerp(targetCFrame, math.clamp(delta * 10, 0, 1))
    end
end

local function startVehicleFly()
    if vehicleFlyEnabled then return end
    vehicleFlyEnabled = true
    if not vehicleFlyConnection then
        vehicleFlyConnection = RunService.Heartbeat:Connect(updateVehicleFly)
    end
end

local function stabilizeCar(anchorTime)
    anchorTime = anchorTime or 0.3
    local root = getRootPart()
    if not root then return end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    root.Anchored = true
    task.wait(anchorTime)
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.RotVelocity = Vector3.zero
end

local function flyCarTo(destination, speed)
    speed = speed or vehicleFlySpeed
    local root = getRoot() -- player's HumanoidRootPart
    if not root then return false end

    if not isInCar() then
        showNotification("Not in car during fly! Re-entering...")
        if not ensureInCar() then return false end
        root = getRoot()
        if not root then return false end
    end

    local hum = getHuman()
    if hum then
        hum.PlatformStand = true   -- Prevents ejection
        hum.AutoRotate = false
    end

    -- Reset velocities
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.RotVelocity = Vector3.zero

    -- Use BodyVelocity and BodyGyro on the player's root
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 1e4
    bg.CFrame = root.CFrame
    bg.Parent = root

    local function cleanup()
        bv:Destroy()
        bg:Destroy()
        if hum then
            hum.PlatformStand = false
            hum.AutoRotate = true
        end
        task.wait(0.2)
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end
    end

    local startPos = root.Position
    local travelY = 600
    local targetHigh = Vector3.new(startPos.X, travelY, startPos.Z)
    local targetDest = destination

    -- Car presence check
    local function checkCar()
        if not isInCar() then
            cleanup()
            showNotification("Car lost during flight!")
            return false
        end
        return true
    end

    -- 1. Rise
    while true do
        if not checkCar() then return false end
        local r = getRoot()
        if not r then cleanup(); return false end
        local diff = targetHigh - r.Position
        if diff.Magnitude < 8 then
            bv.Velocity = Vector3.zero
            break
        end
        bv.Velocity = diff.Unit * speed
        local lookDir = diff.Unit
        if lookDir.Magnitude > 0.1 then
            bg.CFrame = CFrame.lookAt(r.Position, r.Position + lookDir)
        end
        task.wait()
    end

    -- 2. Horizontal
    local targetXZ = Vector3.new(targetDest.X, travelY, targetDest.Z)
    while true do
        if not checkCar() then return false end
        local r = getRoot()
        if not r then cleanup(); return false end
        local diff = targetXZ - r.Position
        if diff.Magnitude < 15 then
            bv.Velocity = Vector3.zero
            break
        end
        bv.Velocity = diff.Unit * speed
        local lookDir = diff.Unit * Vector3.new(1,0,1)
        if lookDir.Magnitude > 0.1 then
            bg.CFrame = CFrame.lookAt(r.Position, r.Position + lookDir)
        end
        task.wait()
    end

    -- 3. Descend
    while true do
        if not checkCar() then return false end
        local r = getRoot()
        if not r then cleanup(); return false end
        local diff = targetDest - r.Position
        if diff.Magnitude < 8 then
            bv.Velocity = Vector3.zero
            break
        end
        bv.Velocity = diff.Unit * speed
        task.wait()
    end

    cleanup()
    stabilizeCar(0.3)
    return true
end

