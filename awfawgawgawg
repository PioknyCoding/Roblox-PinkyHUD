local numberlinkSolving = false
local puzzleSolved = false
local numberlinkGuiConn = nil

local function findFlow()
    for _, v in ipairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "Grid") and rawget(v, "FlowId") and rawget(v, "Draw") then
            return v
        end
    end
    return nil
end

local function solveGrid(initialGrid)
    local rows, cols = #initialGrid, #initialGrid[1]
    local dirs = {{-1,0},{1,0},{0,-1},{0,1}}
    local endpoints = {}
    for r = 1, rows do
        for c = 1, cols do
            local val = initialGrid[r][c]
            if val and val >= 0 then
                endpoints[val] = endpoints[val] or {}
                table.insert(endpoints[val], {r = r, c = c})
            end
        end
    end
    local colors = {}
    for color, pts in pairs(endpoints) do
        if #pts == 2 then table.insert(colors, color) end
    end
    if #colors == 0 then return nil end
    local function key(r,c) return r..","..c end
    local occupied = {}
    for _, pts in pairs(endpoints) do
        for _, p in ipairs(pts) do
            occupied[key(p.r, p.c)] = true
        end
    end
    local function inBounds(r,c)
        return r >= 1 and r <= rows and c >= 1 and c <= cols
    end
    local function canEnter(r,c,goalKey)
        if not inBounds(r,c) then return false end
        local k = key(r,c)
        return occupied[k] == nil or k == goalKey
    end
    local function bfsDistance(start, goal)
        local goalKey = key(goal.r, goal.c)
        local queue = {{r=start.r, c=start.c, dist=0}}
        local visited = {[key(start.r,start.c)] = true}
        local head = 1
        while head <= #queue do
            local cur = queue[head]; head = head + 1
            if cur.r == goal.r and cur.c == goal.c then return cur.dist end
            for _, d in ipairs(dirs) do
                local nr, nc = cur.r + d[1], cur.c + d[2]
                local k = key(nr, nc)
                if not visited[k] and canEnter(nr, nc, goalKey) then
                    visited[k] = true
                    queue[#queue+1] = {r=nr, c=nc, dist=cur.dist+1}
                end
            end
        end
        return nil
    end
    local function manhattan(a,b)
        return math.abs(a.r-b.r) + math.abs(a.c-b.c)
    end
    local function countOpenMoves(from, goal)
        local goalKey = key(goal.r, goal.c)
        local count = 0
        for _, d in ipairs(dirs) do
            local nr, nc = from.r + d[1], from.c + d[2]
            if canEnter(nr, nc, goalKey) then count = count + 1 end
        end
        return count
    end
    local function chooseNextColor(remaining)
        local bestId, bestScore
        for _, colorId in ipairs(remaining) do
            local pts = endpoints[colorId]
            local dist = bfsDistance(pts[1], pts[2])
            if not dist then return nil end
            local freedom = countOpenMoves(pts[1], pts[2]) + countOpenMoves(pts[2], pts[1])
            local score = freedom * 10000 + dist * 10 + manhattan(pts[1], pts[2])
            if not bestScore or score < bestScore then
                bestId = colorId
                bestScore = score
            end
        end
        return bestId
    end
    local function copyPath(path)
        local result = {}
        for i, p in ipairs(path) do result[i] = {r=p.r, c=p.c} end
        return result
    end
    local function countEmptyNeighbors(r,c,goalKey)
        local count = 0
        for _, d in ipairs(dirs) do
            local nr, nc = r + d[1], c + d[2]
            local k = key(nr, nc)
            if inBounds(nr, nc) and (occupied[k] == nil or k == goalKey) then
                count = count + 1
            end
        end
        return count
    end
    local function sortedNeighbors(cur, goal, visited)
        local goalKey = key(goal.r, goal.c)
        local neighbors = {}
        for _, d in ipairs(dirs) do
            local nr, nc = cur.r + d[1], cur.c + d[2]
            local k = key(nr, nc)
            if not visited[k] and canEnter(nr, nc, goalKey) then
                neighbors[#neighbors+1] = {r=nr, c=nc}
            end
        end
        table.sort(neighbors, function(a,b)
            local da = manhattan(a, goal)
            local db = manhattan(b, goal)
            if da ~= db then return da < db end
            local fa = countEmptyNeighbors(a.r, a.c, goalKey)
            local fb = countEmptyNeighbors(b.r, b.c, goalKey)
            if fa ~= fb then return fa < fb end
            if a.r ~= b.r then return a.r < b.r end
            return a.c < b.c
        end)
        return neighbors
    end
    local solutions = {}
    local function solveRemaining(remaining)
        if #remaining == 0 then
            for r = 1, rows do
                for c = 1, cols do
                    if inBounds(r,c) and occupied[key(r,c)] == nil then
                        return false
                    end
                end
            end
            return true
        end
        local colorId = chooseNextColor(remaining)
        if not colorId then return false end
        local pts = endpoints[colorId]
        local start, goal = pts[1], pts[2]
        local startKey, goalKey = key(start.r, start.c), key(goal.r, goal.c)
        local oldStart, oldGoal = occupied[startKey], occupied[goalKey]
        occupied[startKey] = nil
        occupied[goalKey] = nil
        local nextRemaining = {}
        for _, id in ipairs(remaining) do
            if id ~= colorId then table.insert(nextRemaining, id) end
        end
        local path = {{r=start.r, c=start.c}}
        local visited = {[startKey] = true}
        local function dfs(cur)
            if cur.r == goal.r and cur.c == goal.c then
                for _, p in ipairs(path) do occupied[key(p.r,p.c)] = colorId end
                if solveRemaining(nextRemaining) then
                    solutions[colorId] = copyPath(path)
                    return true
                end
                for _, p in ipairs(path) do
                    local k = key(p.r,p.c)
                    if k ~= startKey and k ~= goalKey then occupied[k] = nil end
                end
                return false
            end
            if not bfsDistance(cur, goal) then return false end
            for _, neighbor in ipairs(sortedNeighbors(cur, goal, visited)) do
                local nk = key(neighbor.r, neighbor.c)
                visited[nk] = true
                path[#path+1] = neighbor
                local old = occupied[nk]
                occupied[nk] = colorId
                if dfs(neighbor) then return true end
                occupied[nk] = old
                path[#path] = nil
                visited[nk] = nil
            end
            return false
        end
        local success = dfs(start)
        occupied[startKey] = oldStart
        occupied[goalKey] = oldGoal
        return success
    end
    if not solveRemaining(colors) then return nil end
    local solved = {}
    for r = 1, rows do
        solved[r] = {}
        for c = 1, cols do
            solved[r][c] = initialGrid[r][c]
        end
    end
    for colorId, path in pairs(solutions) do
        for _, p in ipairs(path) do
            solved[p.r][p.c] = colorId
        end
    end
    return solved
end

local function solveNumberlink()
    if numberlinkSolving then return end
    numberlinkSolving = true
    puzzleSolved = false
    local flow = findFlow()
    if flow then
        local solved = solveGrid(flow.Grid)
        if solved then
            local rows, cols = #solved, #solved[1]
            for r = 1, rows do
                for c = 1, cols do
                    if flow.Grid[r][c] < 0 then
                        flow.Grid[r][c] = solved[r][c]
                    end
                end
            end
            if flow.OnConnection then
                flow.OnConnection()
            end
            puzzleSolved = true
        end
    end
    numberlinkSolving = false
end

